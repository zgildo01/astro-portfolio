# Choose one source for portfolio content builds (resume and case studies).
# Local sibling checkout; reads committed resume.md and portfolio/work/*.md
# from the configured vault branch. Uncommitted edits are not published.
# RESUME_VAULT_DIR=../Zeus-Vault

# Hosted build; this existing token also reads case studies. Store it as a
# repository secret with Contents: read access
# to the private Zeus-Vault repository. Do not commit a token here.
# RESUME_CONTENT_TOKEN=

# Public build settings; these values appear in the generated contact page.
# Use a Turnstile widget restricted to the production site's hostname.
# PUBLIC_TURNSTILE_SITE_KEY=
# Optional direct-email fallback; only set an address intended for publication.
# PUBLIC_CONTACT_EMAIL=

# Contact provider secrets belong in Cloudflare Worker secrets, not PUBLIC_ vars.
# Use .dev.vars for local Wrangler settings; see .dev.vars.example.

# Optional canonical HTTPS origin when moving to an owned domain.
# PORTFOLIO_SITE_URL=https://zeus-zaragoza-portfolio.zgildo01.workers.dev
