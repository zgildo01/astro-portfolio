{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeus-zaragoza-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "7001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
