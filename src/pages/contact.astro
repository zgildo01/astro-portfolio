---
import PageIntro from "../components/page/PageIntro.astro";
import AtmosphericNote from "../components/atmosphere/AtmosphericNote.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageMetadata } from "../config/pageMetadata";
import { withBasePath } from "../lib/routing";
import "../styles/atmosphere-content.css";

const metadata = pageMetadata.contact;
---

<BaseLayout {...metadata}>
  <div class="page contact-page atmospheric-page">
    <PageIntro
      headerClass="contact-page__header atmospheric-page-intro"
      eyebrow="Get in touch"
      title="Contact"
    >
      Interested in discussing platform engineering, developer tooling, or a
      professional opportunity? This page will provide a direct and accessible
      way to reach me.
    </PageIntro>

    <div class="atmospheric-editorial-grid">
      <div class="atmospheric-editorial-copy">
        <section
          class="contact-page__status atmospheric-content-block"
          aria-labelledby="contact-status-heading"
        >
          <p class="atmospheric-section-number">01 / In preparation</p>

          <h2 id="contact-status-heading">Contact experience in progress</h2>

          <p>
            Contact options are being prepared. In the meantime, you can explore
            my professional background and selected work below.
          </p>
        </section>

        <section
          class="contact-page__alternatives atmospheric-content-block"
          aria-labelledby="contact-alternatives-heading"
        >
          <h2 id="contact-alternatives-heading">Explore my work</h2>

          <p>
            While the contact experience is being completed, you can review my
            professional background and selected work.
          </p>

          <ul class="page-actions atmospheric-actions">
            <li>
              <a href={withBasePath("/resume", import.meta.env.BASE_URL)}
                >View my resume</a
              >
            </li>

            <li>
              <a href={withBasePath("/work", import.meta.env.BASE_URL)}
                >View selected work</a
              >
            </li>
          </ul>
        </section>
      </div>

      <AtmosphericNote text="We could build so much together." />
    </div>
  </div>
</BaseLayout>
