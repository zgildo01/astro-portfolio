---
import PageIntro from "../components/page/PageIntro.astro";
import SceneFigure from "../components/atmosphere/SceneFigure.astro";
import interior from "../assets/scenery/interior.png";
import { pageMetadata } from "../config/pageMetadata";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBasePath } from "../lib/routing";
import "../styles/atmosphere-content.css";

const metadata = pageMetadata.about;
---

<BaseLayout {...metadata}>
  <article class="page about-page atmospheric-page">
    <div class="atmospheric-about-grid">
      <div class="atmospheric-about-copy">
        <PageIntro
          headerClass="about-page__header atmospheric-page-intro"
          eyebrow="Professional profile"
          title="About"
        >
          I’m {siteConfig.name}, a {siteConfig.role}. This page will provide a
          concise introduction to my professional background, engineering
          approach, and the work represented throughout this portfolio.
        </PageIntro>

        <section class="about-page__status atmospheric-content-block">
          <p class="atmospheric-section-number">01 / In preparation</p>
          <h2>About page in progress</h2>

          <p>
            A fuller professional biography, working philosophy, and supporting
            background will be added as the portfolio’s professional content is
            developed.
          </p>
        </section>

        <section class="about-page__scope atmospheric-content-block">
          <h2>What this page will cover</h2>

          <ul>
            <li>My professional background and progression</li>
            <li>My approach to engineering and technical problem-solving</li>
            <li>
              The principles that guide the work presented in this portfolio
            </li>
          </ul>
        </section>

        <section class="about-page__next-steps atmospheric-content-block">
          <h2>Continue exploring</h2>

          <ul class="page-actions atmospheric-actions">
            <li>
              <a href={withBasePath("/resume", import.meta.env.BASE_URL)}
                >View my resume</a
              >
            </li>

            <li>
              <a href={withBasePath("/work", import.meta.env.BASE_URL)}
                >View selected work</a
              >
            </li>

            <li>
              <a href={withBasePath("/contact", import.meta.env.BASE_URL)}
                >Contact me</a
              >
            </li>
          </ul>
        </section>
      </div>

      <SceneFigure
        image={interior}
        alt="An empty waiting room with burgundy curtains, two dark chairs, a lit floor lamp, and an open doorway into a cold blue corridor."
        caption="There is more to know."
        number="02"
        variant="interior"
      />
    </div>
  </article>
</BaseLayout>
