---
import { pageMetadata } from "../config/pageMetadata";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const metadata = pageMetadata.about;
---

<BaseLayout {...metadata}>
  <article class="about-page">
    <header class="about-page__header">
      <p class="about-page__eyebrow">Professional profile</p>

      <h1>About</h1>

      <p class="about-page__introduction">
        I’m {siteConfig.name}, a {siteConfig.role}. This page will provide a
        concise introduction to my professional background, engineering
        approach, and the work represented throughout this portfolio.
      </p>
    </header>

    <section class="about-page__status">
      <h2>About page in progress</h2>

      <p>
        A fuller professional biography, working philosophy, and supporting
        background will be added as the portfolio’s professional content is
        developed.
      </p>
    </section>

    <section class="about-page__scope">
      <h2>What this page will cover</h2>

      <ul>
        <li>My professional background and progression</li>
        <li>My approach to engineering and technical problem-solving</li>
        <li>The principles that guide the work presented in this portfolio</li>
      </ul>
    </section>

    <section class="about-page__next-steps">
      <h2>Continue exploring</h2>

      <ul>
        <li>
          <a href="/resume">View my resume</a>
        </li>

        <li>
          <a href="/work">View selected work</a>
        </li>

        <li>
          <a href="/contact">Contact me</a>
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>