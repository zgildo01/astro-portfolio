---
import PageIntro from "../components/page/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageMetadata } from "../config/pageMetadata";

const metadata = pageMetadata.resume;
---

<BaseLayout {...metadata}>
  <article class="page resume-page">
    <PageIntro
      headerClass="resume-page__header"
      eyebrow="Professional record"
      title="Resume"
    >
      This page will provide a concise overview of my professional experience,
      technical strengths, and platform-engineering work.
    </PageIntro>

    <section
      class="resume-page__status incomplete-state"
      aria-labelledby="resume-status-heading"
    >
      <h2 id="resume-status-heading">Resume in progress</h2>

      <p>
        The complete web resume, print presentation, and downloadable PDF will
        be introduced during the dedicated resume-system pillar.
      </p>
    </section>

    <section
      class="resume-page__next-steps"
      aria-labelledby="resume-next-steps-heading"
    >
      <h2 id="resume-next-steps-heading">Explore in the meantime</h2>

      <ul class="page-actions">
        <li>
          <a href="/work">View selected work</a>
        </li>

        <li>
          <a href="/contact">Contact me</a>
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>
