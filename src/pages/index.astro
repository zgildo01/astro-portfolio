---
import { pageMetadata } from "../config/pageMetadata";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const metadata = pageMetadata.home;
---

<BaseLayout {...metadata}>
  <div class="page page-landing home-page">
    <header>
      <p class="page-eyebrow">Professional portfolio</p>

      <h1>{siteConfig.name}</h1>

      <p class="page-landing__role">{siteConfig.role}</p>

      <p class="page-introduction">
        I build and maintain dependable development platforms, tooling, and
        engineering workflows.
      </p>
    </header>

    <section aria-labelledby="home-actions-heading">
      <h2 id="home-actions-heading">Explore my work</h2>

      <p>
        Review my professional background, explore selected engineering work, or
        get in touch.
      </p>

      <ul class="page-actions">
        <li>
          <a href="/resume">View my resume</a>
        </li>

        <li>
          <a href="/work">View selected work</a>
        </li>

        <li>
          <a href="/contact">Contact me</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
