---
import PageIntro from "../../components/page/PageIntro.astro";
import AtmosphericNote from "../../components/atmosphere/AtmosphericNote.astro";
import CaseStudyCard from "../../components/work/CaseStudyCard.astro";
import { pageMetadata } from "../../config/pageMetadata";
import { loadPortfolioForBuild } from "../../lib/content/loadPortfolioForBuild";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBasePath } from "../../lib/routing";
import "../../styles/atmosphere-content.css";
import "../../styles/work.css";

const metadata = pageMetadata.work;
const { caseStudies } = await loadPortfolioForBuild({
  vaultDir: import.meta.env.RESUME_VAULT_DIR,
  token: import.meta.env.RESUME_CONTENT_TOKEN
});
---

<BaseLayout {...metadata}>
  <div class="page work-page atmospheric-page">
    <PageIntro
      headerClass="work-page__header atmospheric-page-intro"
      eyebrow="Selected work"
      title="Work"
    >
      Engineering work focused on dependable developer tooling and the workflows
      teams use to understand and build on existing capabilities.
    </PageIntro>

    <div class="atmospheric-editorial-grid">
      <div class="atmospheric-editorial-copy">
        <section class="work-list" aria-labelledby="work-list-heading">
          <h2 id="work-list-heading">Engineering case studies</h2>

          {
            caseStudies.length > 0 ? (
              <ul class="work-list__items">
                {caseStudies.map((caseStudy) => (
                  <li>
                    <CaseStudyCard caseStudy={caseStudy} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="work-empty-state">
                <h3>Case studies in preparation</h3>
                <p>
                  Selected engineering work will appear here when it is ready to
                  share. In the meantime, my resume covers my professional
                  background and experience.
                </p>
                <a href={withBasePath("/resume", import.meta.env.BASE_URL)}>
                  View my resume
                </a>
              </div>
            )
          }
        </section>

        <section
          class="work-page__next-steps atmospheric-content-block"
          aria-labelledby="work-next-steps-heading"
        >
          <h2 id="work-next-steps-heading">Continue exploring</h2>

          <ul class="page-actions atmospheric-actions">
            <li>
              <a href={withBasePath("/resume", import.meta.env.BASE_URL)}
                >View my resume</a
              >
            </li>

            <li>
              <a href={withBasePath("/about", import.meta.env.BASE_URL)}
                >Learn more about me</a
              >
            </li>

            <li>
              <a href={withBasePath("/contact", import.meta.env.BASE_URL)}
                >Contact me</a
              >
            </li>
          </ul>
        </section>
      </div>

      <AtmosphericNote text="Good work rarely goes unnoticed." />
    </div>
  </div>
</BaseLayout>
