---
import { experiencePaths } from "../routes";
interface Props {
  active: "home" | "confidence";
}
const { active } = Astro.props;
const paths = experiencePaths(import.meta.env.BASE_URL);
---

<header>
  <div class="edition-bar">
    <div class="edition-inner shell">
      <p>Fictional company · interactive satire</p><a href={paths.portfolio}
        >Leave this site ↗</a
      >
    </div>
  </div>
  <div class="corporate-header shell">
    <a class="brand" href={paths.company} aria-label="Brood Civic Systems home"
      ><svg viewBox="0 0 40 40" aria-hidden="true"
        ><path
          d="M6 29 20 6l14 23M6 29h28"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"></path><circle
          cx="20"
          cy="6"
          r="3.6"
          fill="currentColor"></circle><circle
          cx="6"
          cy="29"
          r="3.6"
          fill="currentColor"></circle><circle
          cx="34"
          cy="29"
          r="3.6"
          fill="currentColor"></circle><circle
          cx="20"
          cy="23"
          r="5.5"
          fill="currentColor"></circle></svg
      ><span
        ><span class="brand-name">BROOD</span>{" "}<span class="brand-subtitle"
          >CIVIC SYSTEMS</span
        ></span
      ></a
    >
    <nav class="corporate-nav" aria-label="Company navigation">
      <a href={active === "home" ? "#platform" : `${paths.company}#platform`}
        >Platform</a
      ><a
        href={paths.confidence}
        aria-current={active === "confidence" ? "page" : undefined}
        >Public confidence</a
      ><a href={paths.investigation}>Independent coverage</a>
    </nav>
  </div>
</header>
