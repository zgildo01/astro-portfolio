---
import { experiencePaths } from "../routes";
interface Props {
  active: "home" | "confidence";
}
const { active } = Astro.props;
const paths = experiencePaths(import.meta.env.BASE_URL);
---

<footer class="corporate-footer">
  <div class="shell">
    <div class="footer-top">
      <div>
        <div class="footer-wordmark">BROOD</div><p class="footer-tagline">
          Everyone accounted for.
        </p>
      </div><nav class="footer-links" aria-label="Company footer">
        {
          active === "home" ? (
            <a href={paths.confidence}>Public confidence</a>
          ) : (
            <a href={paths.company}>Company home</a>
          )
        }<a href={paths.investigation}>Independent coverage</a><a
          href={paths.explainer}>Data &amp; rights explainer</a
        ><a href={paths.portfolio}>Leave this site ↗</a>
      </nav>
    </div><div class="footer-bottom">
      <p>
        Fictional company · interactive satire. Brood and its incident are
        invented for this experience.
      </p><p>Care continues beyond the frame.</p>
    </div>
  </div>
</footer>
