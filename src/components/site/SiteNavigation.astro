---
import { siteConfig } from "../../config/site";
import { normalizeRoutePath, withBasePath } from "../../lib/routing";
import styles from "./SiteNavigation.module.css";

type NavigationPlacement = "header" | "footer" | "mobile";

interface Props {
  label?: string;
  placement?: NavigationPlacement;
}

const { label = "Primary", placement = "header" } = Astro.props;

const currentPath = normalizeRoutePath(Astro.url.pathname);
---

<nav class={styles.navigation} data-placement={placement} aria-label={label}>
  <ul class={styles.list}>
    {
      siteConfig.primaryNavigation.map((item) => {
        const href = withBasePath(item.href, import.meta.env.BASE_URL);
        const itemPath = normalizeRoutePath(href);
        const isCurrentPage = currentPath === itemPath;
        const isCurrentLocation =
          item.href !== "/" && currentPath.startsWith(`${itemPath}/`);

        return (
          <li>
            <a
              class={styles.link}
              href={href}
              aria-current={
                isCurrentPage
                  ? "page"
                  : isCurrentLocation
                    ? "location"
                    : undefined
              }
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
