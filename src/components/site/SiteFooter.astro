---
import { siteConfig } from "../../config/site";
import SiteNavigation from "./SiteNavigation.astro";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <p class="site-footer__name">{siteConfig.name}</p>
      <p class="site-footer__role">{siteConfig.role}</p>
    </div>

    <SiteNavigation placement="footer"/>

    <p class="site-footer__copyright">
      <small>&copy; {currentYear} {siteConfig.name}</small>
    </p>
  </div>
</footer>