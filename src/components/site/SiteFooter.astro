---
import { siteConfig } from "../../config/site";
import SiteNavigation from "./SiteNavigation.astro";
import styles from "./SiteFooter.module.css";

const currentYear = new Date().getFullYear();
---

<footer class={styles.footer}>
  <div class:list={["shell-container", styles.inner]}>
    <div class={styles.identity}>
      <p class={styles.name}>{siteConfig.name}</p>
      <p class={styles.role}>{siteConfig.role}</p>
    </div>

    <SiteNavigation placement="footer" />

    <p class={styles.copyright}>
      <small>&copy; {currentYear} {siteConfig.name}</small>
    </p>
  </div>
</footer>
