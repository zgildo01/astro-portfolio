---
import { siteConfig } from "../../config/site";
import { normalizeRoutePath } from "../../lib/routing";

const currentYear = new Date().getFullYear();
const currentPath = normalizeRoutePath(Astro.url.pathname);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <p class="site-footer__name">{siteConfig.name}</p>
      <p class="site-footer__role">{siteConfig.role}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {
          siteConfig.primaryNavigation.map((item) => (
            <li>
              <a 
                href={item.href}
                aria-current={
                  currentPath === normalizeRoutePath(item.href) ? "page" : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="site-footer__copyright">
      <small>&copy; {currentYear} {siteConfig.name}</small>
    </p>
  </div>
</footer>