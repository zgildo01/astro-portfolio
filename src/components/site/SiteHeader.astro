---
import { siteConfig } from "../../config/site";
import { withBasePath } from "../../lib/routing";
import MobileNavigation from "./MobileNavigation.astro";
import SiteNavigation from "./SiteNavigation.astro";
import styles from "./SiteHeader.module.css";
---

<header class={styles.header}>
  <div class:list={["shell-container", styles.inner]}>
    <div class={styles.identity}>
      <p class={styles.name}>
        <a href={withBasePath("/", import.meta.env.BASE_URL)}
          >{siteConfig.name}</a
        >
      </p>

      <p class={styles.role}>{siteConfig.role}</p>
    </div>

    <div class={styles.fullNavigation}>
      <SiteNavigation placement="header" />
    </div>

    <div class={styles.mobileNavigation}>
      <MobileNavigation />
    </div>
  </div>
</header>
