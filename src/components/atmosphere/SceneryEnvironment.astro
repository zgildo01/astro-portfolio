---
import { getImage } from "astro:assets";
import clinicalBloom from "../../assets/scenery/clinical-bloom.png";
import withheldReflection from "../../assets/scenery/withheld-reflection.png";
import closedPassage from "../../assets/scenery/closed-passage.png";
import styles from "./SceneryEnvironment.module.css";

const [bloomPlate, reflectionPlate, passagePlate] = await Promise.all(
  [clinicalBloom, withheldReflection, closedPassage].map((src) =>
    getImage({
      src,
      width: Math.min(1100, src.width),
      widths: [480, 768, Math.min(1100, src.width)],
      format: "webp",
      quality: 72
    })
  )
);
const ghostPlate = await getImage({
  src: withheldReflection,
  width: 768,
  format: "webp",
  quality: 72
});
const ascending = [bloomPlate, reflectionPlate, bloomPlate, reflectionPlate];
const descending = [passagePlate, bloomPlate, passagePlate, bloomPlate];
---

<div class={styles.environment} aria-hidden="true" data-scenery-environment>
  <div class={styles.reels}>
    <div class:list={[styles.reel, styles.ascending]}>
      <div class={styles.track} data-scenery-effect>
        {
          ascending.map((plate) => (
            <img
              src={plate.src}
              srcset={plate.srcSet.attribute}
              sizes="(max-width: 47.999rem) 80vw, 55vw"
              {...plate.attributes}
              alt=""
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          ))
        }
      </div>
    </div>
    <div class:list={[styles.reel, styles.descending]}>
      <div class={styles.track} data-scenery-effect>
        {
          descending.map((plate) => (
            <img
              src={plate.src}
              srcset={plate.srcSet.attribute}
              sizes="(max-width: 47.999rem) 80vw, 55vw"
              {...plate.attributes}
              alt=""
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          ))
        }
      </div>
    </div>
  </div>
  <div
    class={styles.ghost}
    style={{ backgroundImage: `url("${ghostPlate.src}")` }}
    data-scenery-effect
  >
  </div>
  <div class={styles.scanlines}></div>
  <div class={styles.roll} data-scenery-effect></div>
  <div class={styles.tear} data-scenery-effect></div>
  <div class={styles.vignette}></div>
</div>
