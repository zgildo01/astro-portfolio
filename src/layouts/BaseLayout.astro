---
import { createHash } from "node:crypto";
import { getImage } from "astro:assets";
import serifFontUrl from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import sansFontUrl from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/shell.css";
import "../styles/patterns.css";
import "../styles/templates.css";
import "../styles/experience-modes.css";

import SceneryEnvironment from "../components/atmosphere/SceneryEnvironment.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SkipLink from "../components/site/SkipLink/SkipLink.astro";
import { siteConfig } from "../config/site";
import { contactConfig } from "../config/contact";
import { resolveSiteOrigin } from "../config/siteOrigin";
import { normalizeRoutePath, withBasePath } from "../lib/routing";
import { canonicalPageUrl, serializeStructuredData } from "../lib/seo";
import arrival from "../assets/scenery/arrival.png";
import { experienceModeBootstrap } from "../lib/atmosphere/experienceMode";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = siteConfig.defaultDescription } = Astro.props;
const origin = resolveSiteOrigin(
  Astro.site?.href ?? import.meta.env.PORTFOLIO_SITE_URL
);
const canonical = canonicalPageUrl(Astro.url.pathname, origin);
const homeUrl = canonicalPageUrl(
  withBasePath("/", import.meta.env.BASE_URL),
  origin
);
const noindex =
  Astro.props.noindex ||
  normalizeRoutePath(Astro.url.pathname) ===
    normalizeRoutePath(withBasePath("/experience", import.meta.env.BASE_URL));
const socialImage = await getImage({
  src: arrival,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 80
});
const socialImageUrl = new URL(socialImage.src, origin).href;
const socialImageAlt =
  "Vacant small-town storefronts and a quiet street at night, from Zeus Zaragoza’s portfolio.";
const personId = `${homeUrl}#person`;
const websiteId = `${homeUrl}#website`;
const structuredData = serializeStructuredData({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: siteConfig.name,
      jobTitle: siteConfig.role,
      url: homeUrl,
      sameAs: [contactConfig.linkedin, contactConfig.github]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: `${siteConfig.name} — ${siteConfig.role}`,
      url: homeUrl,
      inLanguage: "en",
      publisher: { "@id": personId }
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      name: title,
      description,
      url: canonical,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      about: { "@id": personId }
    }
  ]
});
if (!noindex) {
  Astro.csp?.insertScriptHash(
    `sha256-${createHash("sha256").update(structuredData).digest("base64")}`
  );
}
const hasScenery =
  !noindex &&
  normalizeRoutePath(Astro.url.pathname) !==
    normalizeRoutePath(withBasePath("/resume", import.meta.env.BASE_URL));
Astro.csp?.insertScriptHash(
  `sha256-${createHash("sha256").update(experienceModeBootstrap).digest("base64")}`
);
---

<!doctype html>
<html
  lang="en"
  data-experience-mode="immersive"
  data-scenery-motion="still"
  data-scenery-paused="true"
>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width" />

    <link
      rel="preload"
      href={serifFontUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={sansFontUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link
      rel="icon"
      href={withBasePath("/favicon.svg", import.meta.env.BASE_URL)}
      type="image/svg+xml"
    />

    <meta name="description" content={description} />

    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />

    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${siteConfig.name} | Portfolio`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={structuredData}
        />
      )
    }

    <title>{title}</title>
  </head>

  <body data-scenery={hasScenery ? "enabled" : undefined}>
    <script is:inline set:html={experienceModeBootstrap} />
    {hasScenery && <SceneryEnvironment />}

    <SkipLink />

    <SiteHeader />

    <main id="main-content" class="shell-container shell-main">
      <span class="main-start-marker" data-main-start-marker aria-hidden="true"
      ></span>
      <slot />
    </main>

    <SiteFooter scenery={hasScenery} />
    <script>
      import { initializeExperienceMode } from "../lib/atmosphere/experienceMode";

      initializeExperienceMode();
    </script>
  </body>
</html>
